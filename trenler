<meta name="claude:viewport-fit-sides" content="cover">
<title>Türkiye Hızlı Tren Haritası</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap">
<style>
/* Layout: map on the left, detail panel and line list on the right. */
:root{
  --bg:#f5f5f2; --panel:#ffffff; --land:rgba(255,255,255,.78); --land-edge:#d7d9de;
  --ink:#15171c; --muted:#6c717b; --line:#2b5fe6; --open:#15171c; --rule:#e4e5e8;
  color-scheme:light;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#0f1115; --panel:#16181e; --land:rgba(255,255,255,.05); --land-edge:#2c3039;
    --ink:#eceef2; --muted:#9097a2; --line:#6d93ff; --open:#dfe3ea; --rule:#262a33;
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#0f1115; --panel:#16181e; --land:rgba(255,255,255,.05); --land-edge:#2c3039;
  --ink:#eceef2; --muted:#9097a2; --line:#6d93ff; --open:#dfe3ea; --rule:#262a33;
  color-scheme:dark;
}
body{background:var(--bg);color:var(--ink);font-family:Inter,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;line-height:1.5}
.wrap{
  max-width:1080px;margin:0 auto;padding-block:28px 24px;
  padding-left:max(16px,env(safe-area-inset-left,0px));
  padding-right:max(16px,env(safe-area-inset-right,0px));
}
.head{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap;margin-bottom:20px}
h1{font-size:22px;font-weight:600;margin:4px 0 6px;letter-spacing:-.01em}
.sub{margin:0;color:var(--muted);font-size:14px;max-width:52ch}
.eyebrow{margin:0;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:500}
.legend{display:flex;gap:16px;font-size:13px;color:var(--muted);align-items:center}
.key{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:6px;vertical-align:middle;flex:none}
.key.ongoing{background:var(--line)}
.key.open{background:var(--open)}

.layout{display:grid;gap:20px;grid-template-columns:minmax(0,1fr)}
@media (min-width:880px){
  .layout{grid-template-columns:minmax(0,1fr) 300px;align-items:start}
}

/* Map: transparent white land on the page background. */
.map-wrap{min-width:0}
#map{display:block;width:100%;height:auto;overflow:visible}
.land{fill:var(--land);stroke:var(--land-edge);stroke-width:1;vector-effect:non-scaling-stroke}
.city{font-size:13px;font-weight:500;fill:var(--muted);paint-order:stroke;stroke:var(--bg);stroke-width:4px;pointer-events:none}

.route{cursor:pointer;outline:none}
.route .hit{fill:none;stroke:transparent;stroke-width:22px}
.route .vis{fill:none;stroke:var(--line);stroke-width:3.5px;stroke-linecap:round;stroke-linejoin:round;vector-effect:non-scaling-stroke;transition:stroke-width .2s ease,opacity .2s ease}
.route.open .vis{stroke:var(--open)}
.route:hover .vis{stroke-width:5.5px}
.route.is-sel .vis{stroke-width:6.5px}
.route:focus-visible .vis{stroke-width:7px}
#map.has-sel .route:not(.is-sel) .vis{opacity:.28}
.rlabel{font-size:15px;font-weight:600;fill:var(--ink);text-anchor:middle;paint-order:stroke;stroke:var(--bg);stroke-width:5px;opacity:0;pointer-events:none;transition:opacity .2s ease}
.route:hover .rlabel,.route.is-sel .rlabel{opacity:1}
.dot{fill:var(--bg);stroke:var(--line);stroke-width:2px;vector-effect:non-scaling-stroke;pointer-events:none}
.dot.open{stroke:var(--open)}

/* Side panel and list. */
